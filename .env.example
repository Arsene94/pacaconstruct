# ─── Supabase ────────────────────────────────────────────────────────────────
# Valori găsite în panoul Supabase: Project Settings → Data API / API Keys.
# Copiază acest fișier în `.env.local` și completează valorile reale.

# URL-ul proiectului (ex: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Cheia publică "anon" (sigură pentru browser, protejată de Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia "service_role" (SECRETĂ, doar pe server). Folosită de generarea AI și
# de ruta de cron pentru a scrie ocolind RLS. NU o expune în browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Aplicație ───────────────────────────────────────────────────────────────
# Originul public folosit pentru SEO (metadata, sitemap, JSON-LD, OG) și pentru
# linkul din emailul de resetare a parolei. În dev poate lipsi (fallback la
# domeniul de producție din app/lib/site-config.ts). Setează-l în producție,
# ex: https://www.pacaconstruct.ro
NEXT_PUBLIC_SITE_URL=

# ─── Verificare proprietate motoare de căutare ───────────────────────────────
# Token-urile de verificare a domeniului. Le obții la adăugarea proprietății:
#   Google  → Search Console → metoda „HTML tag" → copiază conținutul content="…"
#   Bing    → Bing Webmaster Tools → opțiunea „Meta tag"
#   Yandex  → Yandex Webmaster (opțional)
# Apar ca <meta name="google-site-verification" …> în <head> (vezi app/layout.tsx).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ─── Tracking / Marketing (opțional) ─────────────────────────────────────────
# ID-ul containerului web Google Tag Manager (format GTM-XXXXXXX). Dacă e gol,
# nu se încarcă nimic (vezi app/components/marketing/marketing-scripts.tsx).
# TOȚI pixelii (GA4, Google Ads, TikTok, Meta) se configurează ÎN GTM și se
# declanșează din evenimentele `pc_*` împinse în dataLayer — niciun ID de vendor
# nu trăiește în cod. Vezi docs/MEASUREMENT-PLAN.md.
NEXT_PUBLIC_GTM_ID=

# ─── Generare bloguri cu AI ──────────────────────────────────────────────────
# Cheie Vercel AI Gateway (https://vercel.com/ai-gateway). Citită automat de
# pachetul `ai`. Necesară pentru analiză topice, scriere articole și imagini.
AI_GATEWAY_API_KEY=

# Secret pentru ruta de cron /api/cron/generate-blog. Vercel Cron îl trimite
# automat ca antet `Authorization: Bearer <CRON_SECRET>` dacă e setat aici.
CRON_SECRET=

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Console Upstash → Redis → REST API. Folosit pentru rate limiting, chei de
# idempotency (joburi QStash) și ca backend al cache-ului de pagini Next.js
# (handlerul `'use cache: remote'`). În dev fără Upstash, rate limiting-ul
# degradează la fail-open și cache-ul la in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Upstash QStash + Workflow ───────────────────────────────────────────────
# Console Upstash → QStash. `QSTASH_TOKEN` autentifică publicarea de joburi;
# cheile de signing verifică automat callback-urile (worker notify + workflow).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Doar pentru dev local cu `npx @upstash/qstash-cli dev`. Lasă gol în producție.
QSTASH_URL=

# ─── Upstash Search ──────────────────────────────────────────────────────────
# Console Upstash → Search → REST. Index full-text + semantic pentru blog.
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=

# ─── Resend (notificări email la cereri noi) ─────────────────────────────────
RESEND_API_KEY=
# Configul vechi (fallback). Preferă variabilele EMAIL_* de mai jos.
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ─── Sistem de email (template-uri, contacte, broadcast) ─────────────────────
# Adrese & branding. Recomandat subdomenii separate tx. (tranzacțional) vs
# news. (marketing) pentru reputație izolată (vezi docs/EMAIL-DELIVERABILITY.md).
EMAIL_FROM_TRANSACTIONAL="PACA CONSTRUCT <noreply@tx.pacaconstruct.ro>"
EMAIL_FROM_MARKETING="PACA CONSTRUCT <salut@news.pacaconstruct.ro>"
EMAIL_REPLY_TO="office@pacaconstruct.ro"
EMAIL_ADMIN_TO="office@pacaconstruct.ro"   # înlocuiește NOTIFY_EMAIL_TO
# Webhooks & unsubscribe
RESEND_WEBHOOK_SECRET=        # din dashboard Resend (Svix), ex. whsec_...
EMAIL_UNSUBSCRIBE_SECRET=     # secret aleator pt. semnarea token-urilor HMAC

# ─── URL public al aplicației ────────────────────────────────────────────────
# Baza pentru callback-urile QStash/Workflow (trebuie accesibil din internet în
# producție). Fallback la NEXT_PUBLIC_SITE_URL, apoi http://localhost:3000.
APP_BASE_URL=
